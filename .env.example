NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_NO_EXPONER

# AI Studio + Asistente del dashboard — obtener en platform.openai.com
OPENAI_API_KEY=sk-...
# Opcional: modelo a usar. Default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Dominio público fijo (recomendado en prod para que el redirect_uri de Meta
# coincida EXACTO y no dependa del origin del preview de Vercel).
NEXT_PUBLIC_SITE_URL=https://dashboardzecamostudios.vercel.app

# Instagram Business Login (Meta Developers → Instagram → API setup with Instagram login)
INSTAGRAM_APP_ID=TU_INSTAGRAM_APP_ID
INSTAGRAM_APP_SECRET=TU_INSTAGRAM_APP_SECRET
